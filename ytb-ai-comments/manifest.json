{
  "manifest_version": 3,
  "name": "YouTube AI Comments",
  "version": "1.4.1",
  "description": "Generate AI-powered replies to YouTube comments using Gemini 2.5 Flash",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://studio.youtube.com/*",
    "*://*.supabase.co/*",
    "https://purpleai.duckdns.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://studio.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://purpleai.duckdns.org/*"],
      "js": ["auth-content.js"],
      "run_at": "document_idle"
    }
  ]
}
