# RunPod Serverless - RVC voice conversion
# Using RunPod's pip-based PyTorch image (NOT conda) to avoid brotli/brotlipy conflict

FROM runpod/pytorch:2.1.0-py3.10-cuda11.8.0-devel-ubuntu22.04

WORKDIR /workspace

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    runpod Brotli \
    "numpy<2" scipy librosa soundfile httpx \
    faiss-cpu praat-parselmouth pyworld \
    "av<12" \
    rvc-python

# Verify brotli works (this is the pip version, no conda conflict)
RUN python -c "import brotli; print('Brotli OK')"
RUN python -c "import runpod; print('RunPod OK')"
RUN python -c "import rvc_python; print('RVC OK')"

COPY handler.py .

ENV RMVPE_MODEL_PATH=/workspace/rmvpe.pt

CMD ["python", "-u", "handler.py"]
