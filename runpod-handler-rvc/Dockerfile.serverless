# RunPod Serverless image for RVC voice conversion

FROM runpod/base:1.0.3-cuda1281-ubuntu2204

WORKDIR /workspace

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    torch torchaudio --index-url https://download.pytorch.org/whl/cu121

RUN pip install --no-cache-dir \
    "numpy<2" scipy librosa soundfile httpx

RUN pip install --no-cache-dir rvc-python || true

COPY handler.py .

ENV RMVPE_MODEL_PATH=/workspace/rmvpe.pt

CMD ["python", "-u", "handler.py"]
