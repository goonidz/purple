# RunPod Serverless image for RVC voice conversion
# Base: CUDA 11.8 + PyTorch 2.1 (compatible with all RunPod GPUs)

FROM pytorch/pytorch:2.1.0-cuda11.8-cudnn8-runtime

WORKDIR /workspace

# System deps
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    git \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Python deps
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install rvc-python (lightweight RVC inference wrapper)
RUN pip install --no-cache-dir rvc-python==0.2.8 || true

# Pre-download RMVPE pitch extraction model (avoids cold-start download)
RUN python -c "import urllib.request; urllib.request.urlretrieve('https://huggingface.co/lj1995/VoiceConversionWebUI/resolve/main/rmvpe.pt', '/workspace/rmvpe.pt'); print('RMVPE downloaded')" || echo "RMVPE pre-download skipped"

# Copy handler
COPY handler.py .

# Tell rvc-python where to find rmvpe
ENV RMVPE_MODEL_PATH=/workspace/rmvpe.pt

CMD ["python", "-u", "handler.py"]
