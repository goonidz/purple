# CRM webmail backend env (FastAPI)
# --------------------------------------------------------------------
# Supabase — used for JWT verification + loading per-user email
# accounts / vault-stored passwords.
SUPABASE_URL=https://laqgmqyjstisipsbljha.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
SUPABASE_JWT_SECRET=replace_with_supabase_jwt_secret

# Only used to sign transient URL tokens (attachment warning etc.).
SESSION_SECRET=replace_with_a_long_random_string_please

# Network — keep bound to localhost, nginx proxies /crm/ → 127.0.0.1:8002
HOST=127.0.0.1
PORT=8002
ROOT_PATH=/crm
