# Port for the video storage API
VIDEO_STORAGE_PORT=3001

# Directory where uploaded videos will be stored
VIDEOS_DIR=/var/www/rendered-videos

# Public URL base for accessing videos (configure nginx to serve VIDEOS_DIR at this path)
PUBLIC_URL_BASE=http://51.91.158.233/rendered-videos

# API authentication token (generate a secure random token)
# This token must be set in RunPod handler environment variables
VIDEO_UPLOAD_TOKEN=your-secure-token-here-generate-with-openssl-rand-hex-32
